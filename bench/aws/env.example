# bench/aws environment. Copy to a private file outside the repository,
# fill in the values, then:  set -a; . ./my-env; set +a
# Nothing in this repository names an account, region or person.

# ---- AWS (required) -------------------------------------------------
# Credentials come from the usual places (environment, AWS_PROFILE, SSO).
AWS_ACCOUNT_ID=000000000000          # 12 digit account the fleet may use; 00-preflight checks it
AWS_REGION=your-region-1             # one region, one Availability Zone
# AZ=your-region-1a                  # default: ${AWS_REGION}a
PROJECT_TAG=ably-server-scale-yourname  # every resource gets Project=$PROJECT_TAG; teardown deletes by it. Default if unset:
                                     # ably-server-scale-<your user name>, so two people in one account never delete each other's fleet

# ---- Access (required) ----------------------------------------------
ADMIN_CIDR=203.0.113.7/32            # your public address; the only source allowed to SSH in
SSH_PUBLIC_KEY_PATH=~/.ssh/bench.pub # an OpenSSH public key; every box authorises it in user-data (no EC2 key pair); the private key is the same path without .pub
# SSH_PRIVATE_KEY_PATH=~/.ssh/bench
# INSTANCE_PROFILE_NAME=             # an existing instance profile with ECR read access, looked up by exact name (skips creating one)
# CREATE_INSTANCE_PROFILE=           # 1 creates an IAM role + instance profile (default: 1 for ecr, 0 for ghcr and none; 1 adds SSM Session Manager).
#                                    # The profile is optional: an IAM denial is a warning and the fleet launches without one.
# Ably internal (ablyctl mints credentials when none are set; see RUNBOOK section 4):
# ABLYCTL_ACCOUNT=dev  AWS_SSO_ROLE=Operator

# ---- Image registry (the fleet runs only; run 0a needs none) -----------
# Where ably-server and ably-loadgen are pushed and pulled. Never a default: set your own.
# IMAGE_REGISTRY=ghcr.io/your-github-owner          # lower case. Or <account>.dkr.ecr.<region>.amazonaws.com[/<prefix>]
#                                    # default with ghcr: ghcr.io/<your GitHub login> (gh api user), looked up only when an image is needed
# IMAGE_REGISTRY_KIND=ghcr           # ghcr (default) | ecr | none. An ECR host in IMAGE_REGISTRY gives ecr.
#                                    # none: no registry; run 0a works, 40-nodes.sh and 50-loadgen.sh stop and say so.
# GHCR_USER=                         # build-push.sh login name; default: gh api user --jq .login (the token is gh auth token; needs write:packages)
# GHCR_PULL_TOKEN=                   # private ghcr packages only: a read:packages token the boxes log in with. It reaches each box over SSH, not in
#                                    # its user-data (RUNBOOK section 3, "Secrets and user-data"). Default: none, and the packages are public (set them public once after the first push).
# GHCR_PULL_USER=                    # login name for that token; default $GHCR_USER, else "token"
# SKIP_REGISTRY_CHECK=1              # skip the anonymous-pull test that 40-nodes.sh and 50-loadgen.sh run against ghcr.io
# BASE_IMAGE_REGISTRY=docker.io      # where postgres, nats, prometheus, grafana and the exporters are pulled from. A mirror has a flat layout
#                                    # (<registry>/<name>:<tag>); "bench/aws/build-push.sh mirror" fills one under IMAGE_REGISTRY:
#                                    #   BASE_IMAGE_REGISTRY="$IMAGE_REGISTRY". Preflight warns about Docker Hub pull limits for more than 10 boxes.

# ---- Money (required before any spend) -------------------------------
ALARM_EMAIL=you@example.invalid      # receives the budget warnings
BUDGET_ALARM_USD=750                 # warn here
BUDGET_CAP_USD=1500                  # hard ceiling; 60-run refuses to start a run that would pass it
# BUDGET_METHOD=cloudwatch           # cloudwatch (default: billing alarms + SNS) | budgets (created but unreadable by the Operator role) | auto
# BUDGET_SCOPE=account               # budgets only: account (counts everything) or tag (Project cost allocation tag; activate it in Billing first)
# PRICE_FACTOR=1                     # scales the local cost estimate (1.1 for eu-west-1); PRICE_<type> overrides one price
# FLEET_PROFILE=2x                   # sizes the vCPU quota check: 2x | 1x
RUN_TIME_LIMIT=90m                   # required by 60-run.sh: 300, 45m, 2h

# ---- State and logs (defaults shown: a git-ignored directory in the repository) --
# STATE.json holds the database password and the API key: never commit it, never paste it.
# STATE_FILE=./bench/aws/state/STATE.json
# LOG_FILE=./bench/aws/state/LOG.md
# RESULTS_DIR=./bench/aws/state/results

# ---- Postgres on EC2 + EBS (20-postgres.sh; not RDS, the role denies it) ----
PG_PASSWORD=change-me-16-chars-min   # letters, digits, _ and - only; at least 16 (RDS_PASSWORD is the old name and still works)
# PG_INSTANCE_TYPE=r7i.4xlarge       # 16 vCPU, 128 GB, x86_64
# PG_STORAGE=io2                     # io2 or gp3; each type gets its own instance so both can exist (RDS_STORAGE still works)
# PG_STORAGE_GB=1000
# PG_IOPS=20000                      # io2 default 20000; gp3 default 12000
# PG_THROUGHPUT_MBPS=500             # gp3 only
# PG_IMAGE=postgres:17               # the official image; the server version actually started is recorded in STATE
# DB_POOL_SIZE=50                    # per node; sizes max_connections with MAX_NODES
# MAX_NODES=20
# SHARDS=1                           # run 8 only: n Postgres instances
# ACTIVE_STORAGE=io2                 # which storage type the nodes use when io2 and gp3 instances both exist

# ---- Fleet ----------------------------------------------------------
# NODE_COUNT=10  NATS_COUNT=3  LOADGEN_COUNT=3  PUBLISHER_COUNT=2
# NODE_INSTANCE_TYPE=c7i.2xlarge  NATS_INSTANCE_TYPE=c7i.2xlarge
# LOADGEN_INSTANCE_TYPE=c7i.8xlarge  PUBLISHER_INSTANCE_TYPE=c7i.4xlarge
# CONDUCTOR_INSTANCE_TYPE=c7i.2xlarge  PGDRIVER_INSTANCE_TYPE=c7i.4xlarge
# NATS_IP_OFFSET=10                  # NATS servers take the three addresses above this offset in the subnet

# ---- What the nodes run (40-nodes.sh) -------------------------------
# BUS=nats                           # nats | postgres | pgnotify | none (none: omit --bus, for the pre-flag main image; this branch then infers postgres)
# SERVER_TAG=                        # image tag in the registry; default: the tag build-push.sh wrote into STATE
# ABLY_SERVER_EXTRA_FLAGS=""         # write path and connection flags. The proof ran every node with --publish-lanes=2:
#                                    #   ABLY_SERVER_EXTRA_FLAGS="--publish-lanes=2"
#                                    # That is now the code default (DESIGN.md section 6.3 "How many lanes"), so empty reproduces it;
#                                    # pin it for an image whose default differs. Keep lanes x nodes near 20 per primary: with more
#                                    # nodes, fewer lanes per node give deeper batches (fewer commits at the same write rate).
#                                    # Every summary.md prints the lane count the nodes reported, which is what a run ran with.
# NODE_GOMAXPROCS=  NODE_GOMEMLIMIT=13GiB

# ---- Load generators (50-loadgen.sh, 60-run.sh) ---------------------
# LOADGEN_TAG=                       # image tag in the registry; default: from STATE
# LOADGEN_CMD=  PUBLISHER_CMD=  CONDUCTOR_CMD=   # see RUNBOOK section 7; NODE_VCPU, NODE_MEMORY_GB default from NODE_INSTANCE_TYPE
# LOADGEN_AGENT_PORT=9200  LOADGEN_METRICS_PORT=9101    # node-exporter uses 9100 on every box
# SCENARIO_DIR=                      # default: bench/scenarios in the repository

# ---- Safety and layout ------------------------------------------------
# FLEET_MAX_UPTIME_H=10              # dead-man switch: every box powers off (and so terminates, disks included) this long after it boots
# USE_PLACEMENT_GROUP=0              # 1 tries a cluster placement group and falls back without one if the role may not create it
# BILLING_REGION=us-east-1           # the region that holds billing metrics (CloudWatch billing alarms)
# ECR_REPO_SERVER=<prefix>/ably-server  ECR_REPO_LOADGEN=<prefix>/ably-loadgen   # ecr only: repository names, default under the IMAGE_REGISTRY path
# TAGGING_API=off                    # teardown and cost-estimate list service by service without trying tag:GetResources first
# OVERRIDE_BUDGET_GUARD=1  FORCE_NO_ALARM=1   # see RUNBOOK; use only after a decision by the budget owner

# ---- Behaviour switches ---------------------------------------------
# DRY_RUN=1                          # print every aws/ssh/scp call, run nothing, write a scratch state file
# SKIP_BOOT_WAIT=1                   # do not wait for cloud-init after launching
# TEARDOWN_ALL=1                     # 90-teardown.sh: also delete the ECR repositories (ecr only), the billing alarms and their SNS topic
# KEEP_POSTGRES=1                    # 80-terminate.sh: leave the Postgres boxes (and their data) up
# AUTO_TERMINATE_AFTER_RUN=1         # 60-run.sh: collect, then terminate the whole fleet
